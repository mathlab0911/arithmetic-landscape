/-
  具体的 3-CNF 式の充足不能性 / 充足可能性の Lean 証明 (作業ID: e2s, 2026-08-05)

  式は 20260805_e2s_random3sat_phase.lean の実験(決定的乱数)から抽出した実データ。
  節 = (正リテラル変数のビットマスク, 負リテラル変数のビットマスク)。
  isSatL n f = 「全 2^n 割当のどれかが f を満たす」を全数計算する Bool 関数。
  decide タクティクにより、主張はカーネル内の全数計算として検証される。
-/

set_option maxRecDepth 8192

def isSatL (n : Nat) (f : List (Nat × Nat)) : Bool :=
  let full := 2 ^ n - 1
  (List.range (2 ^ n)).any (fun a =>
    f.all (fun c => ((a &&& c.1) != 0) || (((a ^^^ full) &&& c.2) != 0)))

-- 実験で生成された UNSAT 例 (n=8, m=40, 節密度 alpha=5.0)
def unsatEx : List (Nat × Nat) := [(25, 0), (164, 0), (4, 33), (50, 0), (10, 4), (128, 5), (0, 19), (64, 36), (68, 8), (65, 128), (80, 8), (132, 16), (8, 96), (0, 224), (25, 0), (8, 34), (138, 0), (130, 64), (6, 16), (1, 192), (16, 36), (160, 16), (4, 24), (129, 4), (132, 32), (32, 20), (68, 128), (80, 4), (128, 20), (64, 36), (0, 162), (1, 68), (4, 130), (32, 144), (8, 48), (33, 2), (37, 0), (40, 128), (11, 0), (0, 138)]

-- 実験で生成された SAT 例 (n=8, m=24, 節密度 alpha=3.0)
def satEx : List (Nat × Nat) := [(12, 2), (128, 40), (148, 0), (144, 1), (82, 0), (129, 16), (0, 73), (12, 128), (0, 176), (8, 132), (25, 0), (176, 0), (12, 2), (9, 64), (64, 24), (160, 2), (10, 128), (18, 8), (44, 0), (9, 16), (12, 1), (66, 128), (8, 36), (13, 0)]

/-- この 8 変数 40 節のランダム式(密度 5.0)は充足不能 -/
theorem unsatEx_unsat : isSatL 8 unsatEx = false := by decide

/-- この 8 変数 24 節のランダム式(密度 3.0)は充足可能 -/
theorem satEx_sat : isSatL 8 satEx = true := by decide

#print axioms unsatEx_unsat
#print axioms satEx_sat
